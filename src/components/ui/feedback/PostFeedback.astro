---
import { getLocale } from "@/lib/localization";
const chinese = getLocale(Astro.url.pathname) === "zh-CN";
const subject = encodeURIComponent(
  `Article feedback: ${new URL(Astro.url.pathname, Astro.site).href}`,
);
---

<div class="mt-12 text-center">
  <a
    class="font-medium text-neutral-700 underline dark:text-neutral-300"
    href={`mailto:support@airdb.cn?subject=${subject}`}
  >
    {
      chinese
        ? "通过邮件反馈这篇文章"
        : "Send feedback about this article by email"
    }
  </a>
</div>
