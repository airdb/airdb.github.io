---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
// import AnnouncementBanner from "@components/ui/banners/AnnouncementBanner.astro";
//import heroImage from "@images/hero-image.avif";
import heroImage from "@images/social.png";
import faqs from "@data/faqs.json";
import features from "@data/features.json";
import pricing from "@data/pricing.json";
import featureImage from "@images/copilot-image-2.png";
import construction from "@images/copilot-image-3.png";
import tools from "@images/copilot-image-1.png";
import dashboard from "@images/copilot-image-2.png";
---

<MainLayout>
  <!--
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore Airdb on GitHub"
    url="https://github.com/airdb"
  />
 -->

  <HeroSection
    title=`WHO WE ARE - <span
        class="text-yellow-500 dark:text-yellow-400">Airdb</span>`
    subTitle="AIRDB is a frontier AI‑native startup built on a unique AI‑first mindset. We revolutionize industries with an AI‑inside approach, placing artificial intelligence at the core of everything we do. We specialize in developing intelligent copilots and delivering a full spectrum of innovative services. By harnessing the transformative power of ABCDS technologies—AI, Blockchain, Cloud, Data, and Security—we empower clients to simplify life and work, boost operational efficiency, and drive sustainable growth."
    primaryBtn="Start Exploring"
    primaryBtnURL="/products"
    secondaryBtn="Contact Sales Team"
    secondaryBtnURL="/contact"
    src={heroImage}
    alt="Overview of Airdb's products and services"
  />

  <FeaturesGeneral
    title="WHY CHOOSE US"
    subTitle="Meeting Industry Demands! At Airdb, we tackle the unique challenges encountered in the AI and Infra Software. From cutting-edge tools to expert services, we're dedicated to helping you overcome obstacles and achieve your business goals.."
    src={featureImage}
    alt="Airdb product showcase"
    features={features}
  />

  <FeaturesNavs
    title=`Customize <span class="text-yellow-500 dark:text-yellow-400">AI Copilot</span> system to perfectly build your business intelligence.`
    tabs={[
      {
        heading: "Cutting-Edge Tools",
        content:
          "Empower your projects with Airdb's cutting-edge AI tools. Experience enhanced efficiency in business operations with our sophisticated automated solutions.",
        svg: "tools",
        src: tools,
        alt: "Screenshot of Airdb's AI tooling interface",
        first: true,
      },
      {
        heading: "Intuitive Dashboards",
        content:
          "Navigate with ease using Airdb's intuitive dashboards. Set up and oversee your application seamlessly, with user-friendly interfaces designed for quick and effective workflow management.",
        svg: "dashboard",
        src: dashboard,
        alt: "A screenshot or graphic representation of the intuitive dashboard",
        second: true,
      },
      {
        heading: "Robust Features",
        content:
          "Minimize complexity, maximize productivity, ensuring your business operates smoothly and efficiently. Designed with resilience and scalability in mind, these features provide the foundation for secure, efficient, and adaptable solutions that can grow alongside your needs.",
        svg: "house",
        src: construction,
        alt: "Screenshot of Airdb's project management interface",
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

  <HeroSectionAlt
    title="Learn. Build. Grow. Earn. Together."
    subTitle="With airdb's higher technologies, you can grow faster with in a stable and secure platform. Start today, and let’s build your path to success together."
    url="https://github.com/airdb"
  />
</MainLayout>
